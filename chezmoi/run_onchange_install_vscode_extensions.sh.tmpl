#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "darwin") (eq .machine_type "desktop") }}
set -euo pipefail

failures=()

# Install an extension into VS Code if the CLI is available.
# Failures are collected rather than aborting, but they are reported at the end —
# silently swallowing them let github.copilot sit in this list unnoticed while
# never actually being installed.
install_ext() {
    local ext="$1"
    if command -v code >/dev/null 2>&1; then
        if ! code --install-extension "$ext" --force >/dev/null 2>&1; then
            failures+=("code: $ext")
        fi
    fi
}

extensions=(
    # Python
    "ms-python.python"
    "charliermarsh.ruff"
    # JS / TS
    "dbaeumer.vscode-eslint"
    "esbenp.prettier-vscode"
    "stylelint.vscode-stylelint"
    "styled-components.vscode-styled-components"
    "yoavbls.pretty-ts-errors"
    "vitest.explorer"
    "denoland.vscode-deno"
    # Kotlin
    "mathiasfrohlich.kotlin"
    # Go
    "golang.go"
    # Shell
    "mkhl.shfmt"
    "timonwong.shellcheck"
    # Git / code review
    "github.vscode-pull-request-github"
    "eamodio.gitlens"
    "mhutchie.git-graph"
    # IaC
    "hashicorp.terraform"
    "redhat.vscode-yaml"
    "github.vscode-github-actions"
    # Docker
    "exiasr.hadolint"
    # Testing
    "ms-playwright.playwright"
    # Data / serialisation
    "mechatroner.rainbow-csv"
    "tamasfe.even-better-toml"
    # Markdown
    "marp-team.marp-vscode"
    "tomoki1207.pdf"
    # AI assistants
    "saoudrizwan.claude-dev"
    # Code quality
    "editorconfig.editorconfig"
    "streetsidesoftware.code-spell-checker"
    "usernamehw.errorlens"
    # Hooks / remote
    "elagil.pre-commit-helper"
    "ms-vscode-remote.remote-containers"
    # Utilities
    "gera2ld.markmap-vscode"
)

for ext in "${extensions[@]}"; do
    install_ext "$ext"
done

if [ ${#failures[@]} -gt 0 ]; then
    echo "WARNING: ${#failures[@]} extension install(s) failed:" >&2
    printf '  %s\n' "${failures[@]}" >&2
fi
{{- else }}
echo "Skipping VS Code extension installation (macOS desktop only)"
{{- end }}

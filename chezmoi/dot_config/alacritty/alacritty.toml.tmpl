general.import = ["~/.config/alacritty/themes/themes/ashes_dark.toml"]

[scrolling]
history = 50000

[font]
size = 10.0
normal.family = "FiraCode Nerd Font"
bold.family = "FiraCode Nerd Font"
italic.family = "FiraCode Nerd Font"
bold_italic.family = "FiraCode Nerd Font"

[window]
opacity = 0.93
blur = true
decorations = "None"
padding = { x = 4, y = 4 }

[selection]
save_to_clipboard = true

[terminal]
osc52 = "CopyPaste"
shell.program = "{{ .chezmoi.homeDir }}/.local/bin/tmux"
shell.args = ["new-session", "-A", "-s", {{ default "main" (get . "tmux_session") | toJson }}]

[keyboard]
bindings = [
  { key = "N", mods = "Super", action = "CreateNewWindow" },
  { key = "C", mods = "Super", action = "Copy" },
  { key = "V", mods = "Super", action = "Paste" },
  { key = "Return", mods = "Shift", chars = "\u001b\r" },
]

# Shift bypasses tmux mouse reporting; Super is Command on macOS.
[[hints.enabled]]
regex = '(https?://[^\s<>"\x00-\x1f]+|[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*)'
hyperlinks = true
post_processing = true
command = { program = "{{ .chezmoi.homeDir }}/.local/bin/open-terminal-link" }
mouse = { enabled = true, mods = "Super|Shift" }
binding = { key = "O", mods = "Super|Shift" }
